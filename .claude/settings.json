{
    "permissions": {
        "allow": [
            "Bash(npm install *)",
            "Bash(npm run build)",
            "Bash(npm run typecheck)",
            "Bash(npm run lint)",
            "Bash(npm run db:generate)",
            "Bash(npm run db:check)",
            "Bash(git status)",
            "Bash(git diff *)",
            "Read(./node_modules/**)"
        ],
        "ask": [
            "Bash(npm run db:migrate)",
            "Bash(npm run db:seed)",
            "Bash(git push *)"
        ],
        "deny": [
            "Read(.env)",
            "Read(.env.*)",
            "Edit(.env)",
            "Edit(.env.*)",
            "Read(./.next/**)"
        ]
    }
}